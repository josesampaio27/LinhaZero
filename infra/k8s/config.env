# The domain of <LZ_DOMAIN> (the landing), app.<LZ_DOMAIN> and account.<LZ_DOMAIN>, read by the API and Keycloak.
# (The web pages need no setting: they work out the other addresses from their own.)
LZ_DOMAIN=linhazero.dev

# Email: Keycloak sends invites and forgotten passwords, the API the access-request emails to the admins. The API reads
# these on every start; Keycloak only in the realm import on its FIRST start: once the realm exists, change Keycloak's
# email in its console (Realm settings → Email) too (infra/k8s/README.md, "Email").
# Brevo (linhazero.dev authenticated there, sender linhazero@linhazero.dev): the SMTP login below, the SMTP key in
# secrets.env (SMTP_PASSWORD). Empty SMTP_HOST = no email.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=linhazero@linhazero.dev
SMTP_USER=bf3a6b001@smtp-brevo.com
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
