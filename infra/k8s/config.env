# The domain of landing.<LZ_DOMAIN>, app.<LZ_DOMAIN> and account.<LZ_DOMAIN>, read by the API and Keycloak.
# (The web pages need no setting: they work out the other addresses from their own.)
LZ_DOMAIN=example.com

# Email (invites, forgotten passwords), sent by Keycloak. For example Brevo: smtp-relay.brevo.com, 587, STARTTLS.
# The sender must be an address the provider has verified. The password goes in secrets.env (SMTP_PASSWORD).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=linhazero@example.com
SMTP_USER=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
