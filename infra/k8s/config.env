# The domain of <LZ_DOMAIN> (the landing), app.<LZ_DOMAIN> and account.<LZ_DOMAIN>, read by the API and Keycloak.
# (The web pages need no setting: they work out the other addresses from their own.)
LZ_DOMAIN=linhazero.dev

# Email (invites, forgotten passwords), sent by Keycloak. Read by the realm import on Keycloak's FIRST start only: once
# the realm exists, change email in the Keycloak console (Realm settings → Email) instead (infra/k8s/README.md, "Email").
# Empty SMTP_HOST = no email yet. For example Brevo: smtp-relay.brevo.com, 587, SMTP_AUTH=true, SMTP_STARTTLS=true, the
# SMTP login in SMTP_USER and the key in secrets.env (SMTP_PASSWORD). The sender must be an address the provider verified.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=linhazero@linhazero.dev
SMTP_USER=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
