# Copy to infra/k8s/secrets.env (gitignored), fill in, and create the cluster's secret from it once (README.md, step 4):
#   kubectl -n linha-zero create secret generic linhazero-secrets --from-env-file=infra/k8s/secrets.env
# Generate each password with: openssl rand -base64 24
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_PASSWORD=
# The same secrets go to Keycloak (realm import) and to the API.
OIDC_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_SECRET=
# The email provider's SMTP password (or API key used as password).
SMTP_PASSWORD=
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token in the install command.
TUNNEL_TOKEN=
# Optional: fogos.pt API key.
FOGOS_API_KEY=
# Optional: Anthropic API key for the assistant (docs/decisoes/0079); without it the assistant is off.
ANTHROPIC_API_KEY=
