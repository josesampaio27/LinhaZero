# Copy to infra/k8s/secrets.env (gitignored). Generate each password with: openssl rand -base64 24
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_PASSWORD=
# The same secret goes to Keycloak (realm import) and to the API.
OIDC_CLIENT_SECRET=
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token in the install command.
TUNNEL_TOKEN=
# Optional: fogos.pt API key.
FOGOS_API_KEY=
