{
  "realm": "linhazero",
  "displayName": "LinhaZero",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 43200,
  "accessTokenLifespan": 300,
  "loginTheme": "linhazero",
  "internationalizationEnabled": true,
  "supportedLocales": ["pt", "en"],
  "defaultLocale": "pt",
  "clients": [
    {
      "clientId": "linhazero-app",
      "name": "LinhaZero",
      "description": "The app at app.${LZ_DOMAIN}; the API is the OIDC client (sessions in a server cookie, no tokens in the browser).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "rootUrl": "https://app.${LZ_DOMAIN}",
      "baseUrl": "/",
      "redirectUris": ["https://app.${LZ_DOMAIN}/api/auth/callback", "${OIDC_EXTRA_REDIRECT_URI}"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://landing.${LZ_DOMAIN}/##https://${LZ_DOMAIN}/##${OIDC_EXTRA_POST_LOGOUT_URI}"
      }
    }
  ]
}
