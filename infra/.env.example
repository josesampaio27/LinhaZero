# Copy to infra/.env (gitignored). Every value below is the default compose uses when the variable is unset.

POSTGRES_PASSWORD=dois

# fogos.pt API key (https://api.fogos.pt/api/request-access), sent in the X-API-Key header. Without it: HTTP 429.
FOGOS_API_KEY=

# The assistant in the app (docs/decisoes/0074): an Anthropic API key (https://console.anthropic.com). Without it the
# assistant is off. Each signed-in user may spend at most ASSISTANT_DAILY_BUDGET_USD a day (US dollars, default 0.50).
ANTHROPIC_API_KEY=
ASSISTANT_DAILY_BUDGET_USD=

# 1 = ingest never contacts the sources; the API serves the newest snapshots (offline demo, see README).
INGEST_OFFLINE=

# Pull intervals in minutes, one per source.
INGEST_INTERVAL_IPMA_OBSERVATIONS=10
INGEST_INTERVAL_IPMA_WARNINGS=10
INGEST_INTERVAL_IPMA_RCM_D0=60
INGEST_INTERVAL_IPMA_STATIONS=1440
INGEST_INTERVAL_IPMA_DISTRICTS=1440
INGEST_INTERVAL_OPEN_METEO=15
INGEST_INTERVAL_FOGOS_ACTIVE=2

# The three addresses: landing.<LZ_DOMAIN>, app.<LZ_DOMAIN> and account.<LZ_DOMAIN> (see infra/README.md, "Login").
LZ_DOMAIN=linhazero.localhost

# Login (Keycloak). The defaults are for a laptop only: set real values anywhere else.
# The same OIDC_CLIENT_SECRET goes to Keycloak (realm import) and to the API.
OIDC_CLIENT_SECRET=dev-secret-change-me
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-admin-secret-change-me

# Email sent by Keycloak (invites, forgotten passwords). Empty = Mailpit, the local fake mailbox (http://localhost:8025).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_FROM=linhazero@example.com
# SMTP_AUTH=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
KEYCLOAK_DB_PASSWORD=keycloak
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
