# Copy to infra/.env (gitignored). Every value below is the default compose uses when the variable is unset.

POSTGRES_PASSWORD=dois

# fogos.pt API key (https://api.fogos.pt/api/request-access), sent in the X-API-Key header. Without it: HTTP 429.
FOGOS_API_KEY=

# 1 = ingest never contacts the sources; the API serves the newest snapshots (offline demo, see README).
INGEST_OFFLINE=

# Pull intervals in minutes, one per source.
INGEST_INTERVAL_IPMA_OBSERVATIONS=10
INGEST_INTERVAL_IPMA_WARNINGS=10
INGEST_INTERVAL_IPMA_RCM_D0=60
INGEST_INTERVAL_IPMA_STATIONS=1440
INGEST_INTERVAL_IPMA_DISTRICTS=1440
INGEST_INTERVAL_OPEN_METEO=15
INGEST_INTERVAL_FOGOS_ACTIVE=2
