# C# style for services/, following Microsoft's C# coding conventions.
# `dotnet format services` applies it; CI runs `dotnet format services --verify-no-changes`.
root = true

[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,json}]
indent_size = 2

[*.cs]
indent_size = 4

# Layout
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = when_multiline:warning

# var where the type is obvious from the right-hand side
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expression bodies only when the whole member fits on one line
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Prefer the language keywords and simple patterns
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_readonly_field = true:warning
csharp_style_unused_value_discard_variable_preference = true:silent

# Naming: PascalCase types and members, _camelCase private fields, Async suffix on async methods
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_rule.private_fields_are_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel.style = underscore_camel
dotnet_naming_rule.private_fields_are_underscore_camel.severity = warning

dotnet_naming_symbols.constants_and_static_readonly.applicable_kinds = field
dotnet_naming_symbols.constants_and_static_readonly.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.static_readonly_are_pascal.symbols = constants_and_static_readonly
dotnet_naming_rule.static_readonly_are_pascal.style = pascal
dotnet_naming_rule.static_readonly_are_pascal.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal
dotnet_naming_rule.constants_are_pascal.severity = warning

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_style.async_suffix.required_suffix = Async
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = async_suffix
dotnet_naming_rule.async_methods_end_in_async.severity = warning

# Tests: xUnit method names are sentences, and test methods are async without the suffix.
[Tests/**.cs]
dotnet_naming_rule.async_methods_end_in_async.severity = none

# Controller actions are named for the HTTP operation (Get, Create), as in the ASP.NET Core docs.
[Api/Controllers/**.cs]
dotnet_naming_rule.async_methods_end_in_async.severity = none
