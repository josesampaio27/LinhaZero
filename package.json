{
  "name": "linha-zero",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "engine-worker",
    "web",
    "landing"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "npm run test -w engine && npm run test -w web",
    "bench": "npm run bench -w engine",
    "grid:synthetic": "npm run grid:synthetic -w engine",
    "typecheck": "npm run typecheck -w engine && npm run typecheck -w web && npm run typecheck -w engine-worker && npm run typecheck -w landing",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:worker": "npm run test -w engine-worker",
    "test:backend": "dotnet test backend",
    "api:client": "dotnet build backend/src/LinhaZero.Api",
    "up": "docker compose up -d --build",
    "up:offline": "docker compose up -d --no-build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "dev:landing": "npm run dev -w landing",
    "build:landing": "npm run build -w landing"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
